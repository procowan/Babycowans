{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": "..",
    "typeRoots": [
      "../sdk/node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@babycowans/core-sdk": [
        "sdk/src/index.ts"
      ],
      "@solana/web3.js": [
        "sdk/node_modules/@solana/web3.js/lib/index.d.ts"
      ]
    }
  },
  "include": [
    "application-bootstrap.ts",
    "read-api.ts",
    "event-decoder.ts"
  ]
}
