{
  "name": "@babycowans/core-sdk",
  "version": "1.0.0",
  "description": "Official TypeScript SDK for the Babycowans Protocol.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "scripts/runtime-dependency-guard.cjs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test:pda": "tsx tests/pda.test.ts",
    "test:instructions": "tsx tests/instructions.test.ts",
    "test:numeric-boundaries": "tsx tests/numeric-boundaries.test.ts",
    "test:idl": "tsx tests/idl-consistency.test.ts",
    "test:decoder": "tsx tests/decoder-layout.test.ts",
    "test:e2e:initialize": "tsx tests/e2e-initialize.test.ts",
    "test:e2e:application": "tsx tests/e2e-register-application.test.ts",
    "test:e2e:asset": "tsx tests/e2e-register-asset.test.ts",
    "test:e2e:configure": "tsx tests/e2e-configure-application-asset.test.ts",
    "test:e2e:payment": "tsx tests/e2e-process-payment.test.ts",
    "test:e2e:membership": "tsx tests/e2e-register-membership.test.ts",
    "test:e2e:reward": "tsx tests/e2e-reward.test.ts",
    "test:e2e:audit": "tsx tests/e2e-audit-log.test.ts",
    "test:e2e": "tsx tests/run-e2e-isolated.ts",
    "onboard": "tsx src/onboarding/DeveloperOnboarding.ts",
    "test:e2e:golden": "tsx tests/e2e-golden-path.test.ts",
    "test:god:phase": "tsx tests/e2e-golden-path.test.ts",
    "test:god": "BABYCOWANS_PHASE=BRC yarn test:god:phase && BABYCOWANS_PHASE=BEC yarn test:god:phase && BABYCOWANS_PHASE=BGC yarn test:god:phase && BABYCOWANS_PHASE=BLC yarn test:god:phase && BABYCOWANS_PHASE=BBC yarn test:god:phase && BABYCOWANS_PHASE=BAC yarn test:god:phase",
    "test:god:isolated": "BABYCOWANS_ISOLATED_SUITE=god tsx tests/run-e2e-isolated.ts",
    "postinstall": "node scripts/runtime-dependency-guard.cjs",
    "test:dependencies": "node scripts/runtime-dependency-guard.cjs --verify",
    "test:audit": "node scripts/runtime-audit-gate.cjs",
    "test:audit:regression": "node tests/runtime-audit-gate.test.cjs",
    "test:e2e:gate-policy": "BABYCOWANS_ISOLATED_SUITE=gate-policy tsx tests/run-e2e-isolated.ts",
    "test:e2e:gate-policy:direct": "tsx tests/e2e-gate-policy.test.ts",
    "test:e2e:token2022": "tsx tests/e2e-token2022-payment.test.ts",
    "test:runtime-boundary": "tsx tests/runtime-boundary.test.ts",
    "test:high-level-client": "tsx tests/high-level-client.test.ts",
    "test:batch": "tsx tests/batch-instructions.test.ts",
    "test:application-experience": "tsx tests/application-experience.test.ts",
    "test:metadata": "tsx tests/metadata.test.ts && tsx tests/metadata-identity.test.ts",
    "test:error-model": "tsx tests/error-model.test.ts",
    "test:property": "tsx tests/phase14-property.test.ts && tsx tests/property-based-resilience.test.ts",
    "test:packed-consumer": "node tests/packed-consumer.test.mjs",
    "test:e2e:bootstrap-example:direct": "tsx tests/packed-bootstrap-example.test.ts",
    "test:e2e:bootstrap-example:isolated": "BABYCOWANS_ISOLATED_SUITE=bootstrap-example tsx tests/run-e2e-isolated.ts"
  },
  "dependencies": {
    "punycode": "2.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.0",
    "esbuild": "0.28.2",
    "@solana/web3.js": "1.98.4"
  },
  "bin": {
    "babycowans": "dist/onboarding/DeveloperOnboarding.js"
  },
  "packageManager": "yarn@1.22.22",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./onboarding": {
      "types": "./dist/onboarding/index.d.ts",
      "import": "./dist/onboarding/index.js",
      "default": "./dist/onboarding/index.js"
    },
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@solana/web3.js": "1.98.4"
  }
}
